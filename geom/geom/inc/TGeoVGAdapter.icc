////////////////////////////////////////////////////////////////////////////////
/// Constructor templated on arguments for UnplacedVolume_t

template <class UnplacedVolume_t>
template <typename... T>
TGeoVGAdapter<UnplacedVolume_t>::TGeoVGAdapter(const TString& name, const T &... params)
  : TGeoShape(name.Data()), UnplacedVolume_t(params...)
{
  // kHalfTolerance = 0.5*kCarTolerance;
  ComputeBBox();
}

////////////////////////////////////////////////////////////////////////////////
/// Destructor

template <class UnplacedVolume_t>
TGeoVGAdapter<UnplacedVolume_t>::~TGeoVGAdapter()
{
  // delete fPolyhedron; fPolyhedron = nullptr;
}

////////////////////////////////////////////////////////////////////////////////
/// operator==

template <class UnplacedVolume_t>
Bool_t TGeoVGAdapter<UnplacedVolume_t>::
operator==(const TGeoVGAdapter& rhs) const
{
  return (this == &rhs) ? true : false;
}

